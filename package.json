{
  "name": "last-stand",
  "version": "0.1.0",
  "private": true,
  "description": "Last Stand - a 3D wave-survival ARPG arena in the browser (Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "check:pages": "node scripts/check-pages-build.mjs",
    "preview": "vite preview",
    "facelab": "node tools/facelab/facelab.mjs",
    "icons": "node tools/icons/icons.mjs",
    "music": "node tools/music/music.mjs",
    "photos": "node tools/photos/photos.mjs",
    "lab": "node tools/lab/lab.mjs",
    "lab:serve": "node tools/lab/lab.mjs serve",
    "fire-bake": "node tools/lab/node/fireBakeSheet.mjs",
    "lab:test": "node --test \"tools/lab/test/*.test.mjs\"",
    "stalls": "node tools/stalls/stalls.mjs",
    "stalls:test": "node --test \"tools/stalls/test/*.test.mjs\"",
    "traces:build": "npm --prefix server/traces/web run build",
    "traces:test": "npm run traces:build && node --test \"server/traces/test/*.test.mjs\"",
    "saves:test": "node --test \"server/saves/test/*.test.mjs\"",
    "saves:drive-token": "node server/saves/driveToken.mjs",
    "saves:restore": "node server/saves/restore.mjs"
  },
  "dependencies": {
    "@dgreenheck/ez-tree": "^1.1.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.2",
    "@types/three": "0.187.0",
    "playwright-core": "^1.61.1",
    "sass": "^1.105.0",
    "typescript": "6.0.2",
    "vite": "8.3.7"
  }
}
